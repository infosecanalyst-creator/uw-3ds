 /* 1 if this build has the MT-32 emulator and dir (a folder, or a file in it) holds a CM-32L or an
@@ -426,3 +447,132 @@ void audio_render_to(uint64_t t_us)
         rendered += (uint64_t)n;
     }
 }
+
+#ifdef __3DS__
+/* ---- the 3DS's synthesis thread ------------------------------------------------------------
+   The drivers run on the timer thread, on the game's core; Nuked OPL3's synthesis there took
+   the game's time. Here every write the drivers make, and each tick's "render up to t", goes
+   into a queue in order, and a thread on another core (plat_thread_start's "synth") plays them
+   back through the functions above: the same output, the same timing in the AIL clock, a
+   little later in real time. With no device (synth_queued 0) the calls go straight through. */
+#undef audio_music_device
+#undef audio_opl_write
+#undef audio_mpu_byte
+#undef audio_dac_play
+#undef audio_dac_stop
+#undef audio_dac_level
+#undef audio_speaker
+#undef audio_render_to
+#include <3ds.h>
+
+enum { EV_RENDER, EV_DEVICE, EV_OPL, EV_MPU, EV_DACPLAY, EV_DACSTOP, EV_DACLEVEL, EV_SPEAKER };
+struct ev { uint8_t type, chip; uint16_t reg; uint32_t a, b; uint64_t t; uint8_t *data; };
+#define QN 32768
+static struct ev q[QN];
+static _Atomic uint32_t q_head, q_tail;
+static LightLock q_lock;
+static int synth_queued;
+static _Atomic unsigned q_dropped;
+
+static void push(const struct ev *e)
+{
+    uint32_t h;
+    if (!synth_queued) return;
+    LightLock_Lock(&q_lock);
+    h = atomic_load(&q_head);
+    if (h - atomic_load(&q_tail) < QN) {
+        q[h % QN] = *e;
+        atomic_store(&q_head, h + 1);
+    } else {
+        if (e->data) free(e->data);
+        atomic_fetch_add(&q_dropped, 1);
+    }
+    LightLock_Unlock(&q_lock);
+}
+
+static int synth_thread(void *arg)
+{
+    (void)arg;
+    for (;;) {
+        uint32_t t = atomic_load(&q_tail), h = atomic_load(&q_head);
+        if (t == h) { svcSleepThread(2000000); continue; }
+        while (t != h) {
+            struct ev *e = &q[t % QN];
+            switch (e->type) {
+            case EV_RENDER: synth_render_to(e->t); break;
+            case EV_DEVICE: synth_music_device((int)e->a); break;
+            case EV_OPL: synth_opl_write(e->chip, e->reg, e->a); break;
+            case EV_MPU: synth_mpu_byte(e->a); break;
+            case EV_DACPLAY: synth_dac_play(e->data, e->a, e->b, e->t); free(e->data); break;
+            case EV_DACSTOP: synth_dac_stop(e->t); break;
+            case EV_DACLEVEL: synth_dac_level(e->a, e->b, e->t); break;
+            case EV_SPEAKER: synth_speaker(e->a, e->t); break;
+            }
+            t++;
+        }
+        atomic_store(&q_tail, t);
+    }
+    return 0;
+}
+
+static void synth_queue_start(void)
+{
+    LightLock_Init(&q_lock);
+    synth_queued = 1;
+    if (plat_thread_start("synth", synth_thread, NULL)) synth_queued = 0;
+}
+
+unsigned audio_queue_depth(void) { return atomic_load(&q_head) - atomic_load(&q_tail); }
+unsigned audio_queue_dropped(void) { return atomic_load(&q_dropped); }
+
+void audio_music_device(int kind)
+{
+    struct ev e = { EV_DEVICE };
+    if (!synth_queued) { synth_music_device(kind); return; }
+    e.a = (uint32_t)kind; push(&e);
+}
+void audio_opl_write(int chip, unsigned reg, unsigned val)
+{
+    struct ev e = { EV_OPL };
+    if (!synth_queued) { synth_opl_write(chip, reg, val); return; }
+    e.chip = (uint8_t)chip; e.reg = (uint16_t)reg; e.a = val; push(&e);
+}
+void audio_mpu_byte(unsigned b)
+{
+    struct ev e = { EV_MPU };
+    if (!synth_queued) { synth_mpu_byte(b); return; }
+    e.a = b; push(&e);
+}
+void audio_dac_play(const uint8_t *data, uint32_t n, uint32_t rate, uint64_t t_us)
+{
+    struct ev e = { EV_DACPLAY };
+    if (!synth_queued) { synth_dac_play(data, n, rate, t_us); return; }
+    if (!n || !(e.data = malloc(n))) return;
+    memcpy(e.data, data, n);
+    e.a = n; e.b = rate; e.t = t_us; push(&e);
+}
+void audio_dac_stop(uint64_t t_us)
+{
+    struct ev e = { EV_DACSTOP };
+    if (!synth_queued) { synth_dac_stop(t_us); return; }
+    e.t = t_us; push(&e);
+}
+void audio_dac_level(unsigned left, unsigned right, uint64_t t_us)
+{
+    struct ev e = { EV_DACLEVEL };
+    if (!synth_queued) { synth_dac_level(left, right, t_us); return; }
+    e.a = left; e.b = right; e.t = t_us; push(&e);
+}
+void audio_speaker(unsigned hz, uint64_t t_us)
+{
+    struct ev e = { EV_SPEAKER };
+    if (!synth_queued) { synth_speaker(hz, t_us); return; }
+    e.a = hz; e.t = t_us; push(&e);
+}
+void audio_render_to(uint64_t t_us)
+{
+    struct ev e = { EV_RENDER };
+    if (!synth_queued) { synth_render_to(t_us); return; }
+    e.t = t_us; push(&e);
+}
+#endif
